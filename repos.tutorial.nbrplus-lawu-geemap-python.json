45,"column":1},"end":{"line":45,"column":1}},"key":"L8274vh2MA"}],"key":"Jr8C8xwaPC"},{"type":"tableCell","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"20 m","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"eN5HM5msNY"}],"key":"ju12Qajwwl"}],"key":"c7duMV94gi"}],"key":"fz98XPTQUQ"},{"type":"thematicBreak","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"Q0WnQ4fCzd"},{"type":"heading","depth":2,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Spectral Index","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"ACHEJXNGEw"}],"identifier":"spectral-index","label":"Spectral Index","html_id":"spectral-index","implicit":true,"key":"ykoajAevcd"},{"type":"heading","depth":3,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"NBR+ (Normalized Burn Ratio Plus)","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"IDJ2efZHzC"}],"identifier":"nbr-normalized-burn-ratio-plus","label":"NBR+ (Normalized Burn Ratio Plus)","html_id":"nbr-normalized-burn-ratio-plus","implicit":true,"key":"qECjv6qIam"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"NBR+ extends the classical NBR by incorporating the Blue (B2) and Green (B3) bands of Sentinel-2 in addition to NIR (B8A) and SWIR2 (B12) (Alcaras et al., 2022):","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"givD3klIKm"}],"key":"BAOc5bKvid"},{"type":"code","lang":"text","value":"NBR+ = (B12 - B8A - B3 - B2) / (B12 + B8A + B3 + B2)","position":{"start":{"line":55,"column":1},"end":{"line":57,"column":1}},"key":"TktvkTi14d"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"The spectral rationale is as follows. Water bodies exhibit strong reflectance in blue-green wavelengths, so including B2 and B3 in the subtraction drives NBR+ values for water pixels toward negative. Clouds also yield strongly negative NBR+ due to their low SWIR2 (B12) reflectance relative to the other three bands. Burned areas, characterized by high SWIR reflectance and low NIR and visible reflectance, produce distinctively high positive NBR+ values. This spectral separation allows burned areas to be identified without reliance on external water or cloud masks.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"KydCBfbyXd"}],"key":"u6KWNXkR9g"},{"type":"heading","depth":3,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Bi-temporal Delta Index (dNBR+)","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"kwtSNWzuin"}],"identifier":"bi-temporal-delta-index-dnbr","label":"Bi-temporal Delta Index (dNBR+)","html_id":"bi-temporal-delta-index-dnbr","implicit":true,"key":"SPV6PxSrZR"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"The bi-temporal approach isolates fire-induced spectral change by differencing pre- and post-fire composites:","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"jmFz70d6b3"}],"key":"Mu4wgUZD6I"},{"type":"code","lang":"text","value":"dNBR+ = NBR+_postfire - NBR+_prefire","position":{"start":{"line":65,"column":1},"end":{"line":67,"column":1}},"key":"yLeS6z294s"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Positive dNBR+ values indicate pixels where NBR+ decreased after the fire, consistent with vegetation loss and increased bare ground exposure.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"HcS8fsCJKH"}],"key":"adPT6NuJpX"},{"type":"thematicBreak","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"PWjGm3nm6p"},{"type":"thematicBreak","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"LmnmLTB1pQ"},{"type":"heading","depth":2,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Project Structure","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"JhNJTJY7yB"}],"identifier":"project-structure","label":"Project Structure","html_id":"project-structure","implicit":true,"key":"RqhEBvEzyD"},{"type":"code","lang":"python","value":"NBRplus-Lawu-Geemap-Python/\n├── notebook.ipynb      # Main analysis notebook (GEE + geemap + cartoee)\n└── README.md","position":{"start":{"line":78,"column":1},"end":{"line":82,"column":1}},"key":"gVjAQfxT3r"},{"type":"thematicBreak","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"VdYuZLPtBE"},{"type":"heading","depth":2,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Workflow","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"Ku5mYEmdAv"}],"identifier":"workflow","label":"Workflow","html_id":"workflow","implicit":true,"key":"qJtQOlqZYI"},{"type":"code","lang":"text","value":"1. Authenticate and initialize Google Earth Engine\n        |\n2. Define AOI — Mount Lawu polygon\n        |\n3. Load Sentinel-2 SR Harmonized collection\n   - Cloud masking via Cloud Score+ (cs_cdf >= 0.6)\n   - Filter by CLOUDY_PIXEL_PERCENTAGE < 20\n        |\n4. Build pre-fire and post-fire median composites\n        |\n5. Compute NBR+ for pre-fire and post-fire images\n        |\n6. Compute dNBR+ = NBR+_post - NBR+_pre\n        |\n7. Apply burn threshold (dNBR+ >= 0.3) to extract burned area mask\n        |\n8. Generate 2x3 visualization panel:\n   A. Pre-fire false color composite  (B11 / B8 / B4)\n   B. Post-fire false color composite (B11 / B8 / B4)\n   C. Post-fire composite with burned area overlay\n   D. Pre-fire NBR+ raster\n   E. Post-fire NBR+ raster\n   F. Burned area mask","position":{"start":{"line":88,"column":1},"end":{"line":112,"column":1}},"key":"gc6cjpMXl5"},{"type":"thematicBreak","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"w4KQ0cV1Fc"},{"type":"heading","depth":2,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","value":"Requirements","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"ALECCSb9c7"}],"identifier":"requirements","label":"Requirements","html_id":"requirements","implicit":true,"key":"eazfutKxuH"},{"type":"code","lang":"bash","value":"pip install geemap cartopy earthengine-api","position":{"start":{"line":118,"column":1},"end":{"line":120,"column":1}},"key":"sU8Pr14sdm"},{"type":"table","position":{"start":{"line":122,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"Package","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"rZExqmQmqH"}],"key":"KuretGXrrv"},{"type":"tableCell","header":true,"position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"Purpose","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"hljmUmqkIS"}],"key":"hTNdyG4vEf"}],"key":"EkpwYsEPdg"},{"type":"tableRow","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"earthengine-api","position":{"start":{"line":124