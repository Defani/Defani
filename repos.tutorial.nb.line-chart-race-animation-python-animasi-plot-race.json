M"},{"type":"block","kind":"notebook-content","data":{"id":"8Pc9JbG5zoD0"},"children":[{"type":"list","ordered":true,"start":9,"spread":false,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Memunculkan data tahun per tahun untuk animasi","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nqojr5VaTF"}],"key":"A6PBb3ENdn"}],"key":"wLXzym2G1n"}],"key":"ppkNHQ3Dj4"}],"key":"spFDFt3SP9"},{"type":"block","kind":"notebook-code","data":{"id":"1OIoyb2PzvwT"},"children":[{"type":"code","lang":"python","executable":true,"value":"ax.spines['top'].set_visible(False)\nax.spines['right'].set_visible(False)\n\ndef update(frame):\n    curr_years = data.index[:frame+1]\n\n    line_hutan.set_data(curr_years, data.loc[curr_years, 'Formasi Hutan'])\n    line_sawit.set_data(curr_years, data.loc[curr_years, 'Sawit'])\n\n    if len(curr_years) > 0:\n        last_year = curr_years[-1]\n        val_h = data.loc[last_year, 'Formasi Hutan']\n        val_s = data.loc[last_year, 'Sawit']\n\n        text_hutan.set_position((last_year, val_h + 1000))\n        text_hutan.set_text(f'{val_h:,.0f}')\n\n        text_sawit.set_position((last_year, val_s - 2000))\n        text_sawit.set_text(f'{val_s:,.0f}')\n\n    return line_hutan, line_sawit, text_hutan, text_sawit\n\n","key":"Wjo9IcO0k2"},{"type":"outputs","id":"ycG7Gpo3QT_CZ4focwQ64","children":[],"key":"et0tXyEceW"}],"key":"bMIvoLu05Y"},{"type":"block","kind":"notebook-content","data":{"id":"oy-aD3Ixz3iU"},"children":[{"type":"list","ordered":true,"start":10,"spread":false,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","val