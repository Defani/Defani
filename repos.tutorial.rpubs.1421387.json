> \n  \n  # Ubah dari format wide ke long agar kompatibel dengan ggplot2\n  pivot_longer(\n    cols      = -c(x, y), \n    names_to  = \"Tahun\", \n    values_to = \"Kelas\"\n  ) |> \n  \n  # Pastikan urutan tahun benar dan kelas sebagai karakter\n  mutate(\n    Tahun = factor(Tahun, levels = tahun), \n    Kelas = as.character(Kelas)\n  )","position":{"start":{"line":141,"column":1},"end":{"line":174,"column":1}},"key":"mN42aCMwol"},{"type":"heading","depth":3,"position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"4.2 Penjelasan Setiap Langkah","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"fRA9axJmkQ"}],"identifier":"id-4-2-penjelasan-setiap-langkah","label":"4.2 Penjelasan Setiap Langkah","html_id":"id-4-2-penjelasan-setiap-langkah","implicit":true,"key":"UZxvWW3nNq"},{"type":"paragraph","position":{"start":{"line":178,"column":1},"end":{"line":179,"column":1}},"children":[{"type":"strong","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"inlineCode","value":"rast(paste0(...))","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"qTXtztIFPQ"}],"key":"k2pK7AgxQ1"},{"type":"break","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"UuhZeJdjGR"},{"type":"text","value":"Membaca seluruh raster tahun sekaligus sebagai objek ","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"WednKJ5mEi"},{"type":"inlineCode","value":"SpatRaster","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"yHtVG1jtFC"},{"type":"text","value":" multilayer menggunakan fungsi ","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"M9vdNJIWzQ"},{"type":"inlineCode","value":"rast()","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"IXVrwFEXsT"},{"type":"text","value":" dari paket ","positi