":1},"end":{"line":9,"column":1}},"key":"efma9UAGm9"}],"key":"m6pGyywx5t"},{"type":"text","value":". Kita tidak menggunakan nilai baku nasional, melainkan menyesuaikan dengan karakteristik lokal mangrove di wilayah studi.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"FQkLvJ0JxI"}],"key":"VawuFBXAzd"},{"type":"image","url":"/build/bddd2afe4b92e1c5319f7ca0d6205ae4.png","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"aYUqdoKsUz","urlSource":"https://cdn-images-1.medium.com/max/1024/1*lV4pldzlWZq3V3P6Db4Xew.png"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"strong","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Menggambar Area Studi","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"ZBqGjj5TYw"}],"key":"rqIMmv1EfY"}],"key":"C4KyiB84Tq"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Area studi dibuat menggunakan tools “Draw shape”, usahakan batasan area studi tidak terlalu luas dan terfokus di wilayah bermangrove agar mudah menentukan nilai threshold.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"y9idDyZuDp"}],"key":"eFg7ttVc1V"},{"type":"image","url":"/build/96b0866e8fd1f248825989066adf3bd6.png","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"ZckQ3KHehJ","urlSource":"https://cdn-images-1.medium.com/max/1024/1*Usz1BxkgjN-aHps4hHzuqw.png"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Pemilihan Area Studi","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"brH3DIYX9P"}],"key":"ZtPzlcaL3m"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"strong","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Masking Awan dengan Band SCL Sentinel-2","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"GayohbW6BB"}],"key":"U2QRDyOAGG"}],"key":"yWTwwnEMMW"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Kita mulai dengan menghilangkan awan dan bayangan awan dari citra Sentinel-2 menggunakan band SCL (Scene Classification Layer). Kita hanya menyisakan piksel yang bukan awan, bayangan awan, dan area tertutup awan.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"Qyk0xUIqXL"}],"key":"QFwzEIfeMs"},{"type":"code","lang":"","value":"var sentinel2_mask = function(image) {\n\n  var scl = image.select('SCL');\n\n  var mask = scl.neq(3)\n\n              .and(scl.neq(8))\n\n              .and(scl.neq(9))\n\n              .and(scl.neq(10))\n\n              .and(scl.neq(11));\n\n  return image.updateMask(mask);\n\n};","position":{"start":{"line":41,"column":1},"end":{"line":57,"column":1}},"key":"jVF1ROyDYn"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"strong","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Memilih Citra Satelit yang Akan Digunakan","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"LHBzK4QCuV"}],"key":"mJjJ50AxzF"}],"key":"pwLgEWg0IL"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Selanjutnya, kita memuat koleksi Sentinel-2 yang telah dikoreksi atmosfer (SR) selama tahun 2024, memfilter awan kurang dari 20%, dan membuat komposit median. Area dibatasi oleh geometry, yaitu polygon batas studi.","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"PgVcFR5gMW"}],"key":"XeUK7SoDWS"},{"type":"code","lang":"","value":"var sentinel2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')\n\n  .filterBounds(geometry)\n\n  .filterDate('2024-01-01', '2025-01-01')\n\n  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))\n\n  .map(sentinel2_mask)\n\n  .median()\n\n  .clip(geometry)\n\n  .multiply(0.0001);","position":{"start":{"line":69,"column":1},"end":{"line":83,"column":1}},"key":"ukVjHgzbLi"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"strong","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"Komposit Band untuk Visualisasi","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"fJdM9Got3x"}],"key":"OLszgEULAq"}],"key":"bfP4AAG6az"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Setelah masking, kita bisa membuat komposit band RGB menggunakan band B8, B11, dan B4. Band ini akan memberikan gambaran visual yang jelas mengenai kondisi vegetasi di wilayah yang kita pelajari.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"zikDOtAZuB"}],"key":"Ly7hhCmPXE"},{"type":"code","lang":"","value":"var multispectral = sentinel2.select(['B8', 'B11', 'B4']);\n\nvar multispectral_param = {min: 0, max: 0.25};\n\nMap.addLayer(multispectral, multispectral_param, 'Sentinel 2 (RGB)');","position":{"start":{"line":95,"column":1},"end":{"line":99,"column":1}},"key":"dHorQsEHvk"},{"type":"image","url":"/build/c8fbb9f3938289c914997f1e054ee942.png","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"fnYmRPN5Dk","urlSource":"https://cdn-images-1.medium.com/max/1024/1*gOwiYAuRE8cG7YxrpDRNjg.png"},{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"Hasil Komposite Band 8–11–4","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"xyCB2zXeTD"}],"key":"zkKMF3P2QV"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"strong","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"Menghitung NDVI","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"msmwonMzRI"}],"key":"Cp7w273eDk"}],"key":"uUk9AgQeoE"},{"type":"paragraph","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"NDVI dihitung menggunakan rumus (NIR - Red) / (NIR + Red), di mana band NIR = B8 dan Red = B4. Nilai ini merepresentasikan kehijauan atau kepadatan vegetasi.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"KKPZGC7f4b"}],"key":"WZZaIGWS0F"},{"type":"code","lang":"","value":"var ndvi = sentinel2.normalizedDifference(['B8', 'B4']).rename('NDVI');","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"pqbmW9QFaW"},{"type":"paragraph","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"strong","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"Menampilkan NDVI","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"NKgXuTH3uT"}],"key":"zyUrU8sQI8"}],"key":"iKYL2x4X9u"},{"type":"paragraph","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"Peta NDVI ditampilkan dengan palet warna dari hitam (vegetasi rendah) hingga hijau gelap (vegetasi tinggi). Ini membantu kita mengidentifikasi area vegetasi padat seperti mangrove.","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"A6VTc7Uaqp"}],"key":"hBU4kf19Fa"},{"type":"code","lang":"","value":"Map.centerObject(geometry, 1