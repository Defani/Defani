oleh PERHUTANI.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"CcBmHGK762"}],"key":"MbTxD0jsIU"},{"type":"heading","depth":2,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"4.2 Kondisi Lingkungan","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"SztM9MUcxW"}],"label":"s4-2-kondisi-lingkungan","identifier":"s4-2-kondisi-lingkungan","html_id":"s4-2-kondisi-lingkungan","key":"gk9lDJErRH"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Berdasarkan penelitian Sodikin ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"PfBagmKh83"},{"type":"emphasis","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"et al","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"K7l2BI0nXU"}],"key":"vH8GMxPnVR"},{"type":"text","value":". (2024) hutan mangrove di desa Patimban merupakan ekosistem estuari dengan kisaran salinitas sekitar 10--30 ppt akibat pengaruh pasang surut dan aliran sungai, pH tanah berkisar antara 6,5--8 yang tergolong netral hingga sedikit basa, serta suhu perairan berkisar 28--32°C yang mendukung aktivitas biologis mangrove. Substrat tanah didominasi oleh lumpur halus hasil sedimentasi Sungai Cipunegara yang kaya bahan organik dan memiliki kemampuan menyimpan air serta nutrien dalam jumlah besar. Kondisi tersebut menjadikan kawasan ini sangat sesuai bagi pertumbuhan mangrove, terutama jenis yang toleran terhadap kondisi estuari seperti Avicennia spp dan Rhizophora spp, serta mendukung perkembangan ekosistem mangrove yang terus mengalami peningkatan luas dari waktu ke waktu.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"UDiNC6UPqA"}],"key":"ndMLSKURfe"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"en