{"version":3,"kind":"Article","sha256":"642f1d2ffb748870cd173c1ad5f288c25a3a14e2bce38402ca9bec218e1bc252","slug":"repos.tutorial.mangrove-vegetation-index-using-terra-package","location":"/repos/tutorial/mangrove-vegetation-index-using-terra-package.md","dependencies":[],"frontmatter":{"title":"Mangrove-Vegetation-Index-Using-Terra-Package","authors":[{"nameParsed":{"literal":"Defani Arman Alfitriansyah","given":"Defani Arman","family":"Alfitriansyah"},"name":"Defani Arman Alfitriansyah","email":"defaniarman@gmail.com","github":"Defani","linkedin":"https://linkedin.com/in/defaniarmanalfitriansyah","id":"contributors-Users\\ASUS\\AppData\\Local\\Temp\\claude\\C--\\63433157-e353-4831-a006-1d7091d9a721\\scratchpad\\site-myst\\myst-generated-uid-0","corresponding":true}],"github":"https://github.com/Defani/Defani","keywords":["forestry","remote sensing","GIS","Google Earth Engine","GeoLibre","QGIS","forest carbon","WebGIS"],"abbreviations":{"GIS":"Geographic Information System","GEE":"Google Earth Engine","SQL":"Structured Query Language","BIG":"Badan Informasi Geospasial (Indonesian Geospatial Information Agency)","KLHK":"Kementerian Lingkungan Hidup dan Kehutanan (Ministry of Environment and Forestry)","BMKG":"Badan Meteorologi, Klimatologi, dan Geofisika","TNGC":"Taman Nasional Gunung Ciremai (Mount Ciremai National Park)","RBI":"Rupabumi Indonesia (official topographic base map)","EUDR":"EU Deforestation Regulation","GBIF":"Global Biodiversity Information Facility"},"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"mangrove-vegetation-index-using-terra-package.md","url":"/build/mangrove-vegetation--a2acf6420e8b5c7c3c60530044c3b037.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This repository provides a complete workflow for mapping mangrove forests using  MVI and Sentinel-2A imagery in R.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"XmBWvUAVAQ"}],"key":"LlGcPck6Hp"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"link","url":"https://github.com/Defani/Mangrove-Vegetation-Index-Using-Terra-Package","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Repositori di GitHub","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"YqjSeulD8N"}],"urlSource":"https://github.com/Defani/Mangrove-Vegetation-Index-Using-Terra-Package","error":true,"key":"HWXbSt8aoh"}],"key":"X5t4L14xIC"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"This repository provides a complete workflow for mapping mangrove forests using Sentinel-2A imagery in R. The analysis applies the Mangrove Vegetation Index (MVI), a spectral index specifically developed to improve mangrove detection compared to general vegetation indices such as NDVI (Baloloy et al., 2020). In addition, the classification process follows the principle of global thresholding, a fundamental image segmentation technique as described by Gonzalez and Woods (2018).","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Z3ShCAx0zT"}],"key":"g1uepUg4xS"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"The workflow includes the following steps:","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"IBdZ3fyN0X"}],"key":"R3zDgDMncv"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Loading Sentinel-2 Bands\nThe key bands required for MVI are Band 8 (NIR), Band 3 (Green), and Band 11 (SWIR). These files are stored in GeoTIFF format and read into R using the terra::rast() function.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"TSNOGnwMhV"}],"key":"hfjJ5aeZTe"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"False-Color Composite Visualization\nA false-color composite (NIR–SWIR–Green) is generated to visualize mangrove vegetation, which typically appears in orange to brown tones. This provides a quick way to inspect potential mangrove areas before index calculation.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"H6TvVunGAY"}],"key":"AKMVquEz18"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Calculation of Mangrove Vegetation Index (MVI)\nThe index is computed using the formula:","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"MKS0R3xYfJ"}],"key":"Pqc5jgmUNo"},{"type":"math","value":"MVI = \\frac{NIR - Green}{SWIR - Green}","position":{"start":{"line":23,"column":1},"end":{"line":25,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>M</mi><mi>V</mi><mi>I</mi><mo>=</mo><mfrac><mrow><mi>N</mi><mi>I</mi><mi>R</mi><mo>−</mo><mi>G</mi><mi>r</mi><mi>e</mi><mi>e</mi><mi>n</mi></mrow><mrow><mi>S</mi><mi>W</mi><mi>I</mi><mi>R</mi><mo>−</mo><mi>G</mi><mi>r</mi><mi>e</mi><mi>e</mi><mi>n</mi></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">MVI = \\frac{NIR - Green}{SWIR - Green}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.10903em;\">M</span><span class=\"mord mathnormal\" style=\"margin-right:0.22222em;\">V</span><span class=\"mord mathnormal\" style=\"margin-right:0