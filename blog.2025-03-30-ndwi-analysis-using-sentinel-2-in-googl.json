n":1}},"key":"xJUiVX56zo"}],"identifier":"id-1-loading-and-filtering-sentinel-2-data","label":"1. Loading and Filtering Sentinel-2 Data","html_id":"id-1-loading-and-filtering-sentinel-2-data","implicit":true,"key":"CJMT7YnIKT"},{"type":"code","lang":"","value":"var sentinel2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')\n\n  .filterDate('2024-01-01', '2025-01-01')\n\n  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20))\n\n  .map(function(img) { return img.updateMask(img.select('QA60').eq(0)); })\n\n  .median().clip(table).multiply(0.0001);","position":{"start":{"line":33,"column":1},"end":{"line":41,"column":1}},"key":"wUd9q4cDrK"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"This code performs:","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"qM1IofyqkK"}],"key":"SFZgPqV2bJ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":49,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":49,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Retrieving Sentinel-2 data within a one-year period (2024–01–01 to 2025–01–01)","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Gt92Ux2jnd"}],"key":"DZ4oCw5MC7"}],"key":"P7tYA9hAdX"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Filtering images with cloud cover below 20%.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"WdBZSxZDef"}],"key":"rPEth4Wp6d"}],"key":"EugKnqs0qE"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Removing cloud effects using the QA60 band.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"kTyxhi1WFg"}],"key":"t4s7d6xQZZ"}],"key":"GM3fIaZ32y"},{"type":"listItem","spread":true,"position":{"start":{"line":55,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Taking the median value of the remaining images and clipping it to the study area.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"Ig7Y3dRHgl"}],"key":"onbWLD7O1R"}],"key":"SfFnvwKWxP"}],"key":"dfcbqKltwP"},{"type":"heading","depth":2,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"2. Calculating NDWI","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"dwBBGntmfU"}],"identifier":"id-2-calculating-ndwi","label":"2. Calculating NDWI","html_id":"id-2-calculating-ndwi","implicit":true,"key":"nrRYdv3lCh"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"NDWI is calculated using the formula: NDWI=Green−NIRGreen+NIRNDWI = \\frac{Green — NIR}{Green + NIR} In Sentinel-2, the green band is B3, and the Near-Infrared (NIR) band is B8. Implementation in ","key":"ZMBCsAeqyt"},{"type":"abbreviation","title":"Google Earth Engine","children":[{"type":"text","value":"GEE","key":"klU361WUOG"}],"key":"Asio0Y0gfD"},{"type":"text","value":":","key":"zWxclKPPRx"}],"key":"NdW8fgJx6Z"},{"type":"code","lang":"","value":"var NDWI = sentinel2.normalizedDifference(['B3', 'B8']).rename('NDWI');","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"mzUcTlFxzd"},{"type":"heading","depth":2,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"3. Visualizing NDWI","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"YxNHLLC8dy"}],"identifier":"id-3-visualizing-ndwi","label":"3. Visualizing NDWI","html_id":"id-3-visualizing-ndwi","implicit":true,"key":"VnzhR0PZlz"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"To display NDWI on the map with a specific color scale:","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"fWRZ6Wn9XT"}],"key":"tcfnOHPtmF"},{"type":"code","lang":"","value":"var ndmiVis = {\n\n  min: -1, max: 1,\n\n  palette: ['#00441b', '#2a924a', '#78c679', '#c2e699', '#ffffcc', \n\n            '#f7fcfd', '#deebf7', '#9ecae1', '#4292c6', '#084594']\n\n};\n\n\n\nMap.addLayer(NDWI, ndmiVis, 'Sentinel 2 - NDWI');","position":{"start":{"line":79,"column":1},"end":{"line":91,"column":1}},"key":"UtDAvUWodB"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"This code displays NDWI with a color scale ranging from dark green (saturated water) to dark blue (very dry areas).","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"qWKGdm7aO2"}],"key":"fivnQ4e3su"},{"type":"heading","depth":2,"position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"4. Adding a Legend","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"yH1RmLSAiE"}],"identifier":"id-4-adding-a-legend","label":"4. Adding a Legend","html_id":"id-4-adding-a-legend","implicit":true,"key":"qk1bYjy5nt"},{"type":"code","lang":"","value":"var legend = ui.Panel({ style: { position: 'bottom-right', padding: '2px', backgroundColor: 'white' } })\n\n  .add(ui.Label('NDWI Value', { fontWeight: 'bold', fontSize: '12px' }));\n\n\n\nvar values = ['-1.0', '-0.6', '-0.2', '0.0', '0.2', '0.4', '0.6', '0.8', '0.9', '1.0'];\n\nvar legendPanel = ui.Panel({ layout: ui.Panel.Layout.flow('vertical') });\n\n\n\nndmiVis.palette.forEach(function(color, i) {\n\n  legendPanel.add(ui.Panel({\n\n    widgets: [\n\n      ui.Label({ style: { backgroundColor: color, padding: '8px 12px', margin: '0px', width: '19px' } }),\n\n      ui.Label(values[i], { margin: '0px', fontSize: '10px', textAlign: 'left' })\n\n    ],\n\n    layout: ui.Panel.Layout.Flow('horizontal'),\n\n    style: { margin: '0px', padding: '0px' }\n\n  }));\n\n});\n\n\n\nMap.add(legend.add(legendPanel));","position":{"start":{"line":103,"column":1},"end":{"line":137,"column":1}},"key":"fPZff8Anle"},{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"This code adds a legend in the bottom-right corner to explain the NDWI values on the map.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"adXmHx3uaY"}],"key":"YJDxRLRgb2"},{"type":"heading","depth":2,"position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"text","value":"5. Displaying Data","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"QXkqLjVLWU"}],"identifier":"id-5-displaying-data","label":"5. Displaying Data","html_id":"id-5-displaying-data","implicit":true,"key":"aiAd60YaKc"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"To view the processed Sentinel-2 imagery, we can print the result in the console:","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"CnkwpCue9r"}],"key":"btGtRAa4mT"},{"type":"code","lang":"","value":"print(sentinel2);","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"RsuQglwGsl"},{"type":"image","url":"/build/b41cf24f59c12ed911e4596b6711