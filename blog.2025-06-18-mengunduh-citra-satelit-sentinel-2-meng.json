67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"link","url":"https://medium.com/media/41b2f192ebcbf64094a84b4d17b1cb93/href","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"https://​medium​.com​/media​/41b2f192ebcbf64094a84b4d17b1cb93​/href","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"QrIiPSf5sV"}],"urlSource":"https://medium.com/media/41b2f192ebcbf64094a84b4d17b1cb93/href","key":"Rd64jAqraK"}],"key":"auyyVOzzPO"},{"type":"heading","depth":3,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"💻 Script ","key":"in4ikpZa7C"},{"type":"abbreviation","title":"Google Earth Engine","children":[{"type":"text","value":"GEE","key":"UF31OFADbm"}],"key":"b3piGkUN8I"},{"type":"text","value":" dengan Komentar","key":"Iqih1nnYf0"}],"identifier":"id-script-gee-dengan-komentar","label":"💻 Script GEE dengan Komentar","html_id":"id-script-gee-dengan-komentar","implicit":true,"key":"ttQPb9VjGE"},{"type":"heading","depth":3,"position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"1. Fungsi Masking Awan (Cloud Masking)","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"NIcIizVZXd"}],"identifier":"id-1-fungsi-masking-awan-cloud-masking","label":"1. Fungsi Masking Awan (Cloud Masking)","html_id":"id-1-fungsi-masking-awan-cloud-masking","implicit":true,"key":"p8c1aPfv9q"},{"type":"code","lang":"","value":"// Fungsi untuk menyaring piksel awan dan bayangan awan berdasarkan nilai SCL\n\nvar sentinel2_mask = function(image) {\n\n  var scl = image.select('SCL'); // Ambil band klasifikasi piksel\n\n  var mask = scl.neq(3)          // Bukan bayangan awan\n\n              .and(scl.neq(8))   // Bukan awan probabilitas sedang\n\n              .and(scl.neq(9))   // Bukan awan tebal\n\n              .and(scl.neq(10))  // Bukan cirrus\n\n              .and(scl.neq(11)); // Bukan awan\n\n  return image.updateMask(mask); // Terapkan masker ke citra\n\n};","position":{"start":{"line":79,"column":1},"end":{"line":97,"column":1}},"key":"iiZsHmePuS"},{"type":"image","url":"/build/644b286366f754b74de2c76de2ca768b.png","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"FoGt9obYe5","urlSource":"https://cdn-images-1.medium.com/max/1024/1*kn_Hk4YgY0Jc_GWvST9x4g.png"},{"type":"paragraph","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"Tabel 1 . SCL Data Properties (Sumber : ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"zssJUlhVWE"},{"type":"link","url":"https://developers.google.com/earth-engine/datasets/catalog/COPERNICUS_S2_SR_HARMONIZED#bands","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"https://​developers​.google​.com​/earth​-engine​/datasets​/catalog​/COPERNICUS​_S2​_SR​_HARMONIZED​#bands","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"gCVzeSyRQK"}],"urlSource":"https://developers.google.com/earth-engine/datasets/catalog/COPERNICUS_S2_SR_HARMONIZED#bands","key":"qsIPFlYB8U"},{"type":"text","value":")","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"nmhdJHHeR9"}],"key":"UoIZNZtLUA"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Blok kode ini adalah kunci untuk mendapatkan citra bersih dari awan. Kita menggunakan SCL (Scene Classification Layer) dari Sentinel-2 Level-2A untuk menyaring piksel yang mengganggu analisis, seperti awan dan bayangannya.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"HXgftX839H"}],"key":"YBe47wn4In"},{"type":"heading","depth":3,"position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"2. Koleksi Sentinel-2 dan Komposit Median","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"Cmh1kWhVfY"}],"identifier":"id-2-koleksi-sentinel-2-dan-komposit-median","label":"2. Koleksi Sentinel-2 dan Komposit Median","html_id":"id-2-koleksi-sentinel-2-dan-komposit-median","implicit":true,"key":"eWSOkqMdfw"},{"type":"code","lang":"","value":"// Ambil koleksi Sentinel-2 tahun 2023, hanya area tertentu, dan awan < 20%\n\nvar citra_rgb = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')\n\n  .filterDate('2023-01-01', '2023-12-31')           // Filter tahun 2023\n\n  .filterBounds(geometry)                           // Area studi\n\n  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20)) // Hanya citra dengan awan <20%\n\n  .map(sentinel2_mask)                              // Terapkan masking awan\n\n  .median()                                         // Komposit median\n\n  .clip(geometry)                                   // Potong ke batas studi\n\n  .multiply(0.0001);                                // Skala reflektansi","position":{"start":{"line":117,"column":1},"end":{"line":133,"column":1}},"key":"StoBPiqj9X"},{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Bagian ini membuat citra komposit tahunan. Kita filter berdasarkan waktu, lokasi, dan cuaca, lalu membuat rata-rata tengah (median) dari semua citra yang lolos. Hasil akhirnya adalah satu citra RGB 2023 yang bersih dari awan.","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"yVOa69GEx1"}],"key":"BDWd45hCPG"},{"type":"heading","depth":3,"position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"strong","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"3. Visualisasi Komposit RGB","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"GwwOFExrvo"}],"key":"ZECTFYodDL"}],"identifier":"id-3-visualisasi-komposit-rgb","label":"3. Visualisasi Komposit RGB","html_id":"id-3-visualisasi-komposit-rgb","implicit":true,"key":"GJHgOGbjQI"},{"type":"code","lang":"","value":"// Parameter visualisasi RGB\n\nvar vis_rgb = {\n\n  bands: ['B4', 'B3', 'B2'], // Merah, Hijau, Biru (Band bisa disesuaikan)\n\n  min: 0.0,\n\n  max: 0.3,\n\n  gamma: 1.1\n\n};\n\n\n\nMap.centerObject(geometry, 11); // Pusatkan ke AOI\n\nMap.addLayer(citra_rgb, vis_rgb, 'Komposit RGB'); // Tambahkan layer ke peta","position":{"start":{"line":145,"column":1},"end":{"line":163,"column":1}},"key":"wwllJJ64Ff"},{"type":"paragraph","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"Agar kita bisa melihat citra sebelum diekspor, kita definisikan parameter visualisasinya. Kita pakai RGB natural (merah, hijau, biru) dan mengatur nilai minimum, maksimum, serta gamma untuk memperbaiki pencahayaan.","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"kTaeN7ri7I"}],"key":"ug7UOmvpdF"},{"type":"heading","depth":3,"position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"children":[{"type":"text","value":"4. Ekspor ke Google Drive","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"TSvjcvfQLK"}],"identifier":"id-4-ekspor-ke-google-drive","label":"4. Ekspor ke Google Drive","html_id":"id-4-ekspor-ke-google-drive","implicit":true,"key":"ehEkL3aupM"},{"type":"code","lang":"","value":"// Ekspor hasil RGB ke Google Drive sebagai file GeoTIFF\n\nExport.image.toDrive({\n\n  image: citra_rgb.select(['B4', 'B3', 'B2']), // Band RGB saja\n\n  description: 'RGB_Sentinel2_2023',           // Nama task\n\n  folder: 'GEE_Export',                        // Folder tujuan\n\n  fileNamePrefix: 'Komposit_RGB_2023',         // Nama file awal\n\n  region: geometry,                            // Batas wilayah ekspor\n\n  scale: 10,                                   // Resolusi (10 meter)\n\n  crs: 'EPSG:4326',                            // Sistem koordinat WGS 84\n\n  maxPixels: 1e13                              // Batas piksel\n\n});","position":{"start":{"line":175,"column":1},"end":{"line":195,"column":1}},"key":"NVqxXLYO8i"},{"type":"paragraph","position":{"start":{"line":199,"column":1},"end":{"line":199,"column":1}},"children":[{"type":"text","value":"Langkah terakhir adalah mengekspor hasilnya ke Drive. Di sini kita hanya ekspor band RGB (B4, B3, B2) dengan resolusi 10 meter. Format output-nya .tif, bisa langsung digunakan di Q","key":"boXYyzyPCz"},{"type":"abbreviation","title":"Geographic Information System","children":[{"type":"text","value":"GIS","key":"C9CJYDirY6"}],"key":"fQ8XYdcfm6"},{"type":"text","value":", Arc","key":"ymKDF3hW3S"},{"type":"abbreviation","title":"Geographic Information System","children":[{"type":"text","value":"GIS","key":"btg9qdAJPR"}],"key":"s9GzL0clQV"},{"type":"text","value":", atau software ","key":"BSzZRZ2bUH"},{"type":"abbreviation","title":"Geographic Information System","children":[{"type":"text","value":"GIS","key":"NSksytYJmm"}],"key":"UvX3chcEyd"},{"type":"text","value":" lainnya.","key":"RuaT3oS3Aa"}],"key":"ShRIgiLpRg"},{"type":"heading","depth":3,"position":{"start":{"line":203,"column":1},"end":{"line":203,"column":1}},"children":[{"type":"text","value":"📁 ","position":{"start":{"line":203,"column":1},"end":{"line":203,"column":1}},"key":"ldIBXO2Zrm"},{"type":"strong","position":{"start":{"line":203,"column":1},"end":{"line":203,"column":1}},"children":[{"type":"text","value":"Output yang Dihasilkan","position":{"start":{"line":203,"column":1},"end":{"line":203,"column":1}},"key":"N7soVdBv2E"}],"key":"cqJsoczKKg"}],"identifier":"id-output-yang-dihasilkan","label":"📁 Output yang Dihasilkan","html_id":"id-output-yang-dihasilkan","implicit":true,"key":"iYp0orZDQR"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":20