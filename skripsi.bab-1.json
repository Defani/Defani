:{"line":15,"column":1}},"key":"r1eB2Uxq95"}],"key":"pSAMNL6nlb"},{"type":"text","value":"., 2024; Taillardat ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"n4uS78EHbS"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"et al","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"BDigwJi4A8"}],"key":"omrRoVjhDt"},{"type":"text","value":"., 2018). Hutan mangrove Indonesia menyimpan sekitar 24% total karbon pesisir global, sehingga keberadaan ekosistem ini menjadi sangat strategis dan menjadi prioritas utama dalam mendukung pencapaian target penurunan emisi gas rumah kaca nasional (Arifanti ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"GGRoYRbOp7"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"et al","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"P8H21m0VeV"}],"key":"Wy4rYBhu9Q"},{"type":"text","value":"., 2024; Gunawan ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"YqpDhVO9L7"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"et al","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"JQ7ZD5tBjH"}],"key":"mUKOXkrbwJ"},{"type":"text","value":"., 2025). Namun demikian, peran penting mangrove secara ekologis masih belum dipahami secara optimal oleh berbagai pihak. Kondisi tersebut menyebabkan konversi dan degradasi hutan mangrove yang berdampak pada menurunnya kemampuan penyerapan karbon. Bahkan, kehilangan simpanan karbon akibat kerusakan mangrove diperkirakan membutuhkan waktu antara 15 sampai 40 tahun untuk mengembalikan stok karbon yang hilang (Wirabuana ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"vMrf4LMY