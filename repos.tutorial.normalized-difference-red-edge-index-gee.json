ng":"javascript","value":"// Cloud Score+ masking\nvar csPlus = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');\n\nfunction maskS2CSPlus(image) {\n  var qa = image.select('cs_cdf');\n  return image.updateMask(qa.gte(0.60));\n}\n\n// Sentinel-2 SR base collection\nvar s2_base = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')\n  .filterBounds(geometry)\n  .filterDate('2024-01-01', '2024-12-31')\n  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20));\n\n// Composite dengan Cloud Score+\nvar composite_csplus = s2_base\n  .linkCollection(csPlus, ['cs_cdf'])\n  .map(maskS2CSPlus)\n  .median()\n  .clip(geometry)\n  .divide(10000);\n\n// Hitung NDRE\nvar ndre = composite_csplus.normalizedDifference(['B8', 'B5']).rename('NDRE');\n\n// Visualisasi\nvar visNDRE = {\n  min: 0,\n  max: 0.6,\n  palette: ['#d73027','#fdae61','#fee08b','#d9ef8b','#66bd63','#1a9850']\n};\n\nMap.addLayer(ndre, visNDRE, 'NDRE Cloud Score+');\nMap.centerObject(geometry, 13);","position":{"start":{"line":78,"column":1},"end":{"line":113,"column":1}},"key":"ZJ2CwqrM2o"},{"type":"thematicBreak","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"PlMKPqEGL1"},{"type":"heading","depth":2,"position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"Catatan","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"nnjY23ILvs"}],"identifier":"catatan","label":"Catatan","html_id":"catatan","implicit":true,"key":"QNrs3I5QlT"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":119,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Variabel ","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"WFlKJKqz8A"},{"type":"inlineCode","value":"geometry","position":{"start